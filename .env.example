####################################################################
# StreamFlix — copy to .env and adjust. Never commit the real .env.
# Values below are safe defaults for local development.
####################################################################

# ---------- runtime ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=1
METRICS_ENABLED=true

# ---------- PostgreSQL (RDS/Aurora in AWS) ----------
POSTGRES_USER=streamflix
POSTGRES_PASSWORD=streamflix_local_pw
POSTGRES_DB=streamflix
DATABASE_URL=postgres://streamflix:streamflix_local_pw@localhost:5432/streamflix
DATABASE_SSL=false
PG_POOL_MAX=10

# ---------- Redis (ElastiCache in AWS) ----------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=120

# ---------- DynamoDB (watch progress) ----------
AWS_REGION=ap-south-1
DYNAMODB_TABLE_WATCH_PROGRESS=streamflix-dev-watch-progress
# Point at DynamoDB Local for development; leave empty to use real DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdev

# ---------- tokens ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
PLAYBACK_TOKEN_SECRET=change-me-playback-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PLAYBACK_TOKEN_TTL_SECONDS=21600

# ---------- media pipeline ----------
# local  -> uploads land on disk, ffmpeg produces HLS, backend serves /media
# s3     -> presigned S3 uploads, MediaConvert produces HLS, CloudFront serves it
STORAGE_DRIVER=local
TRANSCODER_DRIVER=ffmpeg
CDN_DRIVER=local

LOCAL_STORAGE_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8080/media
MAX_UPLOAD_BYTES=5368709120

S3_BUCKET_RAW=streamflix-dev-raw-videos
S3_BUCKET_PROCESSED=streamflix-dev-processed-videos
S3_BUCKET_THUMBNAILS=streamflix-dev-thumbnails
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=

CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM contents (\n escaped) or a file path readable by the pod
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Fallback manifest used when a title has no processed HLS asset yet,
# so "Play" works before you upload anything. Remove in production.
DEMO_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# ---------- payments ----------
PAYMENTS_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
CURRENCY=INR

# ---------- rate limiting ----------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------- worker ----------
# Probes and metrics for the worker Deployment (it serves no traffic of its own).
WORKER_PORT=9090
# One ffmpeg process per slot — keep this at or below the pod's CPU limit.
TRANSCODE_CONCURRENCY=1
TRANSCODE_MAX_ATTEMPTS=3
# How long a 'processing' job may go quiet before it is assumed orphaned and requeued.
TRANSCODE_STALE_MINUTES=45
# MediaConvert only: how often to ask AWS about outstanding jobs.
REMOTE_POLL_SECONDS=20
SHUTDOWN_TIMEOUT_MS=15000

# ---------- seed accounts (development only) ----------
SEED_ADMIN_EMAIL=admin@streamflix.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@streamflix.local
SEED_USER_PASSWORD=Demo@12345

# ---------- frontend (Vite reads these at build time) ----------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=StreamFlix
